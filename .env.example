# Backend đã deploy trên Render. Không thêm /api/v1 vào các biến origin này.
# VITE_API_ORIGIN được dùng khi build/preview production.
VITE_API_ORIGIN=https://homestay-booking-management-system.onrender.com
# Vite dev server dùng biến này để chuyển /api/v1 và /media tới Backend đã deploy.
VITE_DEV_API_PROXY_TARGET=https://homestay-booking-management-system.onrender.com
# Địa chỉ tuyệt đối nhận báo cáo lỗi giao diện, không bắt buộc.
VITE_ERROR_REPORTING_ENDPOINT=
# Mã phiên bản, ví dụ Git SHA hoặc phiên bản triển khai, không bắt buộc.
VITE_APP_RELEASE=
