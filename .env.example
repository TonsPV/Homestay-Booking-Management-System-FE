# Production endpoints must use HTTPS. HTTP is accepted only for loopback development.
VITE_API_ORIGIN=http://localhost:3000
# Optional Vite development proxy target. Defaults to VITE_API_ORIGIN, then localhost.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
# Optional absolute endpoint that accepts frontend runtime error reports.
VITE_ERROR_REPORTING_ENDPOINT=
# Optional release identifier such as a Git SHA or deployment version.
VITE_APP_RELEASE=


